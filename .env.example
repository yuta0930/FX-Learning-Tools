# Secrets and config (DO NOT commit real values)
# Copy this file to ".env" locally and fill values.
# Blank means feature disabled by default.

# === Safety & Mode ===
MODE=paper # paper | live
KILL_SWITCH=0 # 1 to force-disable trading

# === Feature toggles ===
ENABLE_OPENAI=0
ENABLE_OANDA=0

# === OpenAI (optional) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === OANDA trading (optional) ===
OANDA_TOKEN=
OANDA_ACCOUNT=

# === Config file override (optional) ===
# Absolute or relative path to a YAML config (falls back to config/config.yml)
FX_CFG=

# HTTP defaults (optional)
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_MS=200

# Health (optional drift thresholds for UI quick check)
HEALTH_MAX_DRIFT_PSI=0.5
HEALTH_MAX_DRIFT_JS=0.3
HEALTH_MAX_BLOCK_RATE=0.8
HEALTH_MAX_UNKNOWN_RATIO=0.3
