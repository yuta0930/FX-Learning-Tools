## Sample environment variables for FX-Learning-Tools

# Core config
# If you want to use an alternative config file, set FX_CFG to its path
# Example: FX_CFG=external/config.yml
FX_CFG=

# Mode/safety toggles for Streamlit app
# MODE can be: paper | live (default is paper if unset in app)
MODE=paper
# If 1, the app will not allow any live actions even if MODE=live
KILL_SWITCH=1

# External APIs (optional)
# OpenAI is used only for explanation/summarization features
OPENAI_API_KEY=

# OANDA (optional: for data feed and order simulation)
OANDA_TOKEN=
OANDA_ACCOUNT=

# Proxy settings (optional)
HTTP_PROXY=
HTTPS_PROXY=

# Logging verbosity (optional)
PYTHONWARNINGS=always

# Performance tuning (optional)
# Price data fetch cache TTL in seconds (default 60)
PRICE_FETCH_TTL=60
# Enable lightweight profiling view in Streamlit sidebar (0/1)
DEV_PROFILING=0

# Additional TTL knobs (optional)
# Event windows (news shading) cache
EVENTS_TTL=300
# Model resource cache
MODEL_CACHE_TTL=600

# Notifications (optional)
# Weekly orchestrator webhook
WEEKLY_WEBHOOK_URL=
# Health check immediate notification webhook
HEALTH_WEBHOOK_URL=

# Security (optional)
# Enforce model signature match at load (0: warn, 1: strict)
STRICT_MODEL_SIGNATURE=0
